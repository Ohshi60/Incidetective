DATABASE_URL=postgresql://incidetective:localdev@localhost:5432/incidetective
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Optional model settings (defaults shown)
# Context window in tokens. Larger lets the app send more evidence, but uses more memory.
# OLLAMA_NUM_CTX=4096
# Maximum answer length in tokens.
# OLLAMA_NUM_PREDICT=1200
# OLLAMA_TIMEOUT_MS=300000

# --- Production Compose (compose.prod.yaml) ---
# Required: password for the bundled Postgres.
# POSTGRES_PASSWORD=change-me
# DATABASE_URL above is for local dev. In Compose, leave it unset to use the
# bundled Postgres, or set it to your own database.
# Ollama defaults to the Docker host (http://host.docker.internal:11434);
# set OLLAMA_BASE_URL if it runs on another machine.
# Where the web UI listens (defaults shown). Use WEB_BIND=0.0.0.0 to expose it on the network.
# WEB_BIND=127.0.0.1
# WEB_PORT=8080
# Prebuilt images instead of building from source (none are published yet).
# API_IMAGE=incidetective-api:local
# WEB_IMAGE=incidetective-web:local
