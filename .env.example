DATABASE_URL=postgresql://incidetective:localdev@localhost:5432/incidetective
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Optional model settings (defaults shown)
# Context window in tokens. Larger lets the app send more evidence, but uses more memory.
# OLLAMA_NUM_CTX=4096
# Maximum answer length in tokens.
# OLLAMA_NUM_PREDICT=1200
# OLLAMA_TIMEOUT_MS=300000
# CPU threads; leave unset on a GPU so Ollama decides.
# OLLAMA_NUM_THREAD=4
